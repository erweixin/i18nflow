{
  "name": "@i18nflow/shared",
  "version": "0.2.0-beta.0",
  "description": "Shared utilities and tools for i18nflow",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "i18n",
    "utilities",
    "ast"
  ],
  "author": "erweixin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/erweixin/i18nflow.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/erweixin/i18nflow#readme",
  "bugs": {
    "url": "https://github.com/erweixin/i18nflow/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@i18nflow/core": "workspace:*",
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/generator": "^7.23.0",
    "@babel/types": "^7.23.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.0",
    "@types/babel__generator": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
