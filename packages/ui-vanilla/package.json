{
  "name": "@i18nflow/ui-vanilla",
  "version": "0.2.1",
  "description": "Framework-agnostic UI for i18nflow debugging (Vanilla JS)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "i18n",
    "vanilla",
    "debug",
    "ui"
  ],
  "author": "erweixin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/erweixin/i18nflow.git",
    "directory": "packages/ui-vanilla"
  },
  "dependencies": {
    "@i18nflow/core": "workspace:*",
    "@i18nflow/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
