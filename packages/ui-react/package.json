{
  "name": "@i18nflow/ui-react",
  "version": "0.1.0",
  "description": "React UI components for i18nflow",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "i18n",
    "react",
    "ui",
    "components"
  ],
  "author": "erweixin",
  "license": "MIT",
  "dependencies": {
    "@i18nflow/core": "workspace:*",
    "@i18nflow/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "antd": ">=5.0.0",
    "@ant-design/icons": ">=5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "react": "^18.3.1",
    "antd": "^5.12.0",
    "@ant-design/icons": "^5.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
