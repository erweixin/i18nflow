{
  "name": "@i18nflow/react-i18next",
  "version": "0.1.0",
  "description": "Complete react-i18next solution for i18nflow",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "i18n-dev-server": "./bin/i18n-dev-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./plugin-next": {
      "types": "./dist/plugin-next.d.ts",
      "import": "./dist/plugin-next.mjs",
      "require": "./dist/plugin-next.js"
    },
    "./plugin-vite": {
      "types": "./dist/plugin-vite.d.ts",
      "import": "./dist/plugin-vite.mjs",
      "require": "./dist/plugin-vite.js"
    },
    "./plugin-rspack": {
      "types": "./dist/plugin-rspack.d.ts",
      "import": "./dist/plugin-rspack.mjs",
      "require": "./dist/plugin-rspack.js"
    },
    "./babel-plugin": {
      "types": "./dist/babel-plugin.d.ts",
      "import": "./dist/babel-plugin.mjs",
      "require": "./dist/babel-plugin.js"
    },
    "./server/dev-server": {
      "types": "./dist/server/dev-server.d.ts",
      "import": "./dist/server/dev-server.mjs",
      "require": "./dist/server/dev-server.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "i18n",
    "react-i18next",
    "i18next",
    "babel-plugin",
    "webpack",
    "vite",
    "next.js"
  ],
  "author": "erweixin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/erweixin/i18nflow.git",
    "directory": "packages/react-i18next"
  },
  "homepage": "https://github.com/erweixin/i18nflow#readme",
  "bugs": {
    "url": "https://github.com/erweixin/i18nflow/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@babel/core": "^7.23.0",
    "@babel/generator": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "@i18nflow/core": "workspace:*",
    "@i18nflow/shared": "workspace:*",
    "@i18nflow/ui-react": "workspace:*"
  },
  "peerDependencies": {
    "i18next": ">=20.0.0",
    "react": ">=16.8.0",
    "react-i18next": ">=11.0.0"
  },
  "devDependencies": {
    "@babel/plugin-syntax-jsx": "^7.23.0",
    "@babel/plugin-syntax-typescript": "^7.23.0",
    "@types/babel__core": "^7.20.0",
    "@types/babel__generator": "^7.6.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@vitest/ui": "^1.0.0",
    "happy-dom": "^12.0.0",
    "jsdom": "^23.0.0",
    "react": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
