{
  "name": "nextjs-react-i18next-demo",
  "version": "1.0.3",
  "private": true,
  "description": "Next.js demo using react-i18next with SSR support and i18nflow debugging",
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:i18n\" -n \"next,i18n\" -c \"cyan,green\"",
    "dev:next": "next dev -p 3035",
    "dev:i18n": "i18n-dev-server -p 3034 -d src/i18n/locales -l zh-CN,en-US -n common",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next node_modules"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "next": "^14.2.0",
    "i18next": "^23.11.0",
    "react-i18next": "^14.1.0",
    "i18next-resources-to-backend": "^1.2.1",
    "i18next-browser-languagedetector": "^7.2.0",
    "accept-language": "^3.0.18",
    "@i18nflow/react-i18next": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.2.0",
    "babel-loader": "^9.1.0",
    "concurrently": "^8.2.2"
  }
}
