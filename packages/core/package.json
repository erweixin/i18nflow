{
  "name": "@i18nflow/core",
  "version": "0.2.2",
  "description": "Core interfaces and types for i18nflow",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "types"
  ],
  "author": "erweixin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/erweixin/i18nflow.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/erweixin/i18nflow#readme",
  "bugs": {
    "url": "https://github.com/erweixin/i18nflow/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
