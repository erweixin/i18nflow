{
  "name": "@i18nflow/kiwi",
  "version": "0.2.2",
  "description": "Complete Kiwi-Intl solution for i18nflow",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./plugin-rspack": {
      "types": "./dist/plugin-rspack.d.ts",
      "import": "./dist/plugin-rspack.mjs",
      "require": "./dist/plugin-rspack.js"
    },
    "./plugin-rsbuild": {
      "types": "./dist/plugin-rsbuild.d.ts",
      "import": "./dist/plugin-rsbuild.mjs",
      "require": "./dist/plugin-rsbuild.js"
    },
    "./plugin-vite": {
      "types": "./dist/plugin-vite.d.ts",
      "import": "./dist/plugin-vite.mjs",
      "require": "./dist/plugin-vite.js"
    },
    "./runtime/debug-ui-injector": {
      "types": "./dist/runtime/debug-ui-injector.d.ts",
      "import": "./dist/runtime/debug-ui-injector.mjs",
      "require": "./dist/runtime/debug-ui-injector.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "keywords": [
    "i18n",
    "kiwi-intl",
    "babel-plugin",
    "webpack",
    "rspack",
    "vite"
  ],
  "author": "erweixin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/erweixin/i18nflow.git",
    "directory": "packages/kiwi"
  },
  "homepage": "https://github.com/erweixin/i18nflow#readme",
  "bugs": {
    "url": "https://github.com/erweixin/i18nflow/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@babel/core": "^7.23.0",
    "@babel/generator": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "@i18nflow/core": "workspace:*",
    "@i18nflow/shared": "workspace:*",
    "@i18nflow/ui-react": "workspace:*",
    "@i18nflow/ui-vanilla": "workspace:*"
  },
  "peerDependencies": {
    "kiwi-intl": ">=1.0.0",
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.0",
    "@types/babel__generator": "^7.6.0",
    "@types/babel__traverse": "^7.20.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@vitest/ui": "^2.0.0",
    "babel-loader": "^9.1.0",
    "react": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
